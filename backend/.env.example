# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Anthropic (answer generation only — Claude has no embedding endpoint)
ANTHROPIC_API_KEY=sk-ant-api03-...
CLAUDE_MODEL=claude-sonnet-4-20250514

# Embedding provider — Google Cloud (Gemini Enterprise Agent Platform)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
# Path to the service-account JSON key file (read automatically by the Google SDK).
# On Railway, upload the key as a file/secret and point this at it.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Frontend
FRONTEND_ORIGIN=https://crewbrief-six.vercel.app

# Storage
STORAGE_BUCKET=documents
